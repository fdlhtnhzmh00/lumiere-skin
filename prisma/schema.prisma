// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// USER MODEL
// =====================
// Menyimpan data akun pengguna untuk autentikasi
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String   // Di-hash dengan bcrypt sebelum disimpan
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("users")
}

// =====================
// CATEGORY MODEL
// =====================
// Kategori produk skincare (10 kategori)
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// =====================
// PRODUCT MODEL
// =====================
// Data produk skincare dengan validasi business rules
// Business Rules: price > 0, stock >= 0, name wajib diisi
model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  ingredients String? // Komposisi bahan produk
  skinType    String? // Jenis kulit yang cocok
  howToUse    String? // Cara penggunaan produk
  price       Float   // Harga dalam Rupiah (harus > 0)
  stock       Int     @default(0) // Stok tersedia (harus >= 0)
  imageUrl    String
  isActive    Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index untuk mempercepat filter produk berdasarkan kategori
  @@index([categoryId])
  // Index untuk pencarian produk aktif
  @@index([isActive])
  // Composite index untuk query produk aktif per kategori
  @@index([categoryId, isActive])
  @@map("products")
}

// =====================
// ORDER MODEL
// =====================
// Data pesanan pengguna dengan status transition
// Business Rules: status transitions DRAFT->CONFIRMED->COMPLETED, CANCELLED
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // Format: LS-{timestamp}-{random}
  status          OrderStatus @default(DRAFT)
  totalPrice      Float
  recipientName   String
  shippingAddress String
  phoneNumber     String
  notes           String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index untuk mempercepat query pesanan per user
  @@index([userId])
  // Index untuk filter pesanan berdasarkan status
  @@index([status])
  // Composite index untuk query pesanan user berdasarkan status
  @@index([userId, status])
  @@map("orders")
}

// =====================
// ORDER ITEM MODEL
// =====================
// Item individual dalam setiap pesanan
// Menyimpan snapshot harga saat pembelian (unitPrice)
model OrderItem {
  id        String @id @default(cuid())
  quantity  Int    // Jumlah produk yang dibeli (1-10, <= stock)
  unitPrice Float  // Harga produk saat transaksi (snapshot)
  subtotal  Float  // quantity * unitPrice

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Index untuk mempercepat query items per order
  @@index([orderId])
  // Index untuk reverse lookup: produk mana yang pernah dipesan
  @@index([productId])
  @@map("order_items")
}

// =====================
// ORDER STATUS ENUM
// =====================
// Aturan transisi status (State Transition Testing):
// DRAFT     -> CONFIRMED  (valid)
// DRAFT     -> CANCELLED  (valid)
// CONFIRMED -> COMPLETED  (valid)
// CONFIRMED -> CANCELLED  (valid)
// COMPLETED -> *          (tidak valid)
// CANCELLED -> *          (tidak valid)
enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

