    {
      "name": "TC-API Products",
      "description": "Test cases untuk endpoint produk (TC-API-01 s/d TC-API-09)",
      "item": [

        {
          "name": "TC-API-01: GET All Products — Ambil Semua Produk",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ── Status Code ──────────────────────────────────────────",
                  "pm.test('TC-API-01: Status code 200 OK', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// ── Response Time ─────────────────────────────────────────",
                  "pm.test('TC-API-01: Response time < 10000ms', function() {",
                  "  pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});",
                  "",
                  "// ── Content Type ──────────────────────────────────────────",
                  "pm.test('TC-API-01: Content-Type adalah application/json', function() {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "// ── Response Body ─────────────────────────────────────────",
                  "pm.test('TC-API-01: Response body success=true', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('TC-API-01: data.products adalah array tidak kosong', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.products).to.be.an('array').and.not.empty;",
                  "});",
                  "",
                  "pm.test('TC-API-01: data.total adalah angka positif', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.total).to.be.a('number').and.greaterThan(0);",
                  "});",
                  "",
                  "// ── Field Wajib per Produk ────────────────────────────────",
                  "pm.test('TC-API-01: Setiap produk memiliki field wajib', function() {",
                  "  var json = pm.response.json();",
                  "  var product = json.data.products[0];",
                  "  pm.expect(product).to.have.property('id');",
                  "  pm.expect(product).to.have.property('name');",
                  "  pm.expect(product).to.have.property('price');",
                  "  pm.expect(product).to.have.property('stock');",
                  "  pm.expect(product).to.have.property('imageUrl');",
                  "  pm.expect(product).to.have.property('category');",
                  "});",
                  "",
                  "// ── Data Types ────────────────────────────────────────────",
                  "pm.test('TC-API-01: Tipe data field produk benar', function() {",
                  "  var json = pm.response.json();",
                  "  var p = json.data.products[0];",
                  "  pm.expect(p.id).to.be.a('string');",
                  "  pm.expect(p.name).to.be.a('string');",
                  "  pm.expect(p.price).to.be.a('number').and.greaterThan(0);",
                  "  pm.expect(p.stock).to.be.a('number').and.greaterThanOrEqual(0);",
                  "  pm.expect(p.isActive).to.be.a('boolean');",
                  "});",
                  "",
                  "// ── JSON Schema Validation ────────────────────────────────",
                  "pm.test('TC-API-01: JSON Schema valid', function() {",
                  "  var json = pm.response.json();",
                  "  var schema = {",
                  "    type: 'object',",
                  "    required: ['success', 'data'],",
                  "    properties: {",
                  "      success: { type: 'boolean' },",
                  "      data: {",
                  "        type: 'object',",
                  "        required: ['products', 'total'],",
                  "        properties: {",
                  "          products: { type: 'array' },",
                  "          total: { type: 'number' }",
                  "        }",
                  "      }",
                  "    }",
                  "  };",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
          }
        },

