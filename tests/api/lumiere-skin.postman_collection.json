    {
      "name": "0 — Setup (Prerequisites)",
      "description": "Request persiapan sebelum test utama: Login untuk token + ambil data awal",
      "item": [

        {
          "name": "S-01: Login — Dapatkan JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('S-01: Login berhasil — status 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('S-01: Response memiliki token JWT', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('token', json.data.token);",
                  "});",
                  "",
                  "pm.test('S-01: Data user dikembalikan', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.user.email).to.equal('user@lumiereskin.com');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },

