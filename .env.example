# Database - Neon PostgreSQL
# Format untuk Vercel production:
# DATABASE_URL: Gunakan pooler URL (dengan pool_timeout=30&connection_limit=5)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?channel_binding=require&sslmode=require&pool_timeout=30&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require"

# Authentication - JWT
JWT_SECRET="your-strong-jwt-secret-key-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# Application
# Ganti dengan URL Vercel deployment Anda setelah deploy
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
NEXT_PUBLIC_APP_NAME="LUMIÈRE SKIN"
